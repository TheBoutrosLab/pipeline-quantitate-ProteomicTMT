includeConfig "../external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "../external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "../external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"
includeConfig "../external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"

methods {
    set_output_dir = {
        tz = TimeZone.getTimeZone("UTC")
        timestamp = new Date().format("yyyyMMdd'T'HHmmss'Z'", tz)
        software = "OpenMS-${params.openms_version}"
        root_output_dir = "${params.output_dir}/${manifest.name}-${manifest.version}"
        output_dir = "${root_output_dir}/${software}"
        params.final_output_dir = "${output_dir}/output"
        params.intermediate_file_dir = "${output_dir}/intermediate"
        log_dir = "${root_output_dir}/log-${manifest.name}-${manifest.version}-${timestamp}/${software}"
        params.log_output_dir = log_dir
        params.process_log_dir = "${log_dir}/process-log"
        params.pipeline_log_dir = "${log_dir}/nextflow-log"
        trace.enabled = true
        trace.file = "${params.pipeline_log_dir}/trace.txt"
        timeline.enabled = true
        timeline.file = "${params.pipeline_log_dir}/timeline.html"
        report.enabled = true
        report.file = "${params.pipeline_log_dir}/report.html"
    }

    validate_tmt = {
        if (!(params.dataset_id?.trim() ==~ /[A-Za-z0-9_.-]+/)) {
            throw new Exception('dataset_id must contain only letters, digits, dots, underscores, or hyphens.')
        }
        if (!(params.tmt_workflow in ['scan_based', 'feature_based'])) {
            throw new Exception("tmt_workflow must be 'scan_based' or 'feature_based'.")
        }
        if (params.FeatureLinkerUnlabeledQT.algorithm.distance_RT.max_difference <= 0 ||
            params.FeatureLinkerUnlabeledQT.algorithm.distance_MZ.max_difference <= 0) {
            throw new Exception('FeatureLinkerUnlabeledQT RT and m/z tolerances must be positive.')
        }
        if (!(params.tmt_normalization_method in ['mad', 'openms'])) {
            throw new Exception("tmt_normalization_method must be 'mad' or 'openms'.")
        }
        // Reporter proportions must remain raw until allocation to MS1 features.
        if (params.tmt_workflow == 'feature_based' && params.enable_tmt_normalization &&
            params.tmt_normalization_method != 'mad') {
            throw new Exception('Feature-based TMT supports MAD normalization only; set tmt_normalization_method=mad.')
        }
        if (params.MADNormalizer.virtual_reference_min_channels < 1) {
            throw new Exception('MADNormalizer.virtual_reference_min_channels must be at least 1.')
        }
        if (params.MADNormalizer.bridge_scale &&
            (params.tmt_workflow != 'feature_based' || !params.enable_tmt_normalization ||
             params.tmt_normalization_method != 'mad' || !params.MADNormalizer.quasi_intensity)) {
            throw new Exception('MAD bridge scaling requires feature_based, MAD normalization, and quasi-intensity output.')
        }
        if (params.MADNormalizer.bridge_scale && params.MADNormalizer.virtual_reference &&
            !params.MADNormalizer.allow_virtual_bridge) {
            throw new Exception('Virtual-reference bridge scaling requires MADNormalizer.allow_virtual_bridge=true.')
        }
        if (params.tmt_workflow == 'feature_based' && params.consensusXML_entrypoint) {
            throw new Exception('Feature-based TMT requires mzML input.')
        }
        if (params.consensusXML_entrypoint) {
            if (!params.containsKey('consensusXML_csv') || !params.consensusXML_csv) {
                throw new Exception('consensusXML_entrypoint=true requires consensusXML_csv.')
            }
        } else {
            if (!params.containsKey('mzML_csv') || !params.mzML_csv) {
                throw new Exception('consensusXML_entrypoint=false requires mzML_csv.')
            }
            if (!params.containsKey('channel_csv') || !params.channel_csv) {
                throw new Exception('consensusXML_entrypoint=false requires channel_csv.')
            }
            if (!params.plex_type?.trim()) {
                throw new Exception('mzML input requires a run-level plex_type.')
            }
        }
        if (params.consensusXML_entrypoint && params.enable_tmt_normalization &&
            params.tmt_normalization_method == 'openms') {
            throw new Exception('OpenMS normalization requires mzML_csv.')
        }
    }

    setup = {
        methods.set_output_dir()
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        methods.validate_tmt()
        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_env()
        methods.configure_containerization()
        methods.setup_process_afterscript()
        json_extractor.store_object_as_json(params, new File("${params.pipeline_log_dir}/params.json"))
    }
}
