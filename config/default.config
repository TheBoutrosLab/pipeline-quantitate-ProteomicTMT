import nextflow.util.SysHelper

params {
    max_cpus = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()
    min_cpus = 1
    min_memory = 1.MB
    resource_allocation_profile_tag = 'default'
    openms_version = '3.5.0'
    docker_image_openms = "ghcr.io/theboutroslab/openms-thirdparty:${params.openms_version}"
    pyopenms_version = '3.5.0'
    docker_image_pyopenms = "ghcr.io/theboutroslab/pyopenms:${params.pyopenms_version}"
    project_script_mount_options = "-v ${projectDir}/src:${projectDir}/src:ro"
    msptools_version = '1.1.1'
    docker_image_msptools = "ghcr.io/theboutroslab/msptools:${params.msptools_version}"
    ucla_cds = false
    save_intermediate_files = false
    remove_mapped_consensus = false
    consensusXML_entrypoint = false
    tmt_workflow = 'scan_based'
    IDMapper {
        consensus {
            use_subelements = false
            annotate_ids_with_subelements = false
        }
    }
    ProteinQuantifier {
        best_charge_and_fraction = true
    }
    MADNormalizer {
        quasi_intensity = true
        bridge_scale = false
        allow_virtual_bridge = false
        virtual_reference = false
        virtual_reference_min_channels = 1
    }
    FeatureLinkerUnlabeledQT {
        algorithm {
            use_identifications = true
            distance_RT { max_difference = 100.0 }
            distance_MZ { max_difference = 10.0; unit = 'ppm' }
        }
    }
    enable_tmt_normalization = true
    tmt_normalization_method = 'openms'
    filter_na_consensus_handles = false
}

process {
    executor = 'local'
    echo = true
}

profiles {
    standard {
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
        docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
    }
    docker {
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
        docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
    }
    apptainer {
        docker.enabled = false
        apptainer.enabled = true
        singularity.enabled = false
        apptainer.autoMounts = true
        apptainer.ociAutoPull = true
        params.project_script_mount_options = "--bind ${projectDir}/src:${projectDir}/src:ro"
    }
    singularity {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
        params.project_script_mount_options = "--bind ${projectDir}/src:${projectDir}/src:ro"
        singularity.ociAutoPull = true
    }
    local {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
        params.project_script_mount_options = ''
    }
}
