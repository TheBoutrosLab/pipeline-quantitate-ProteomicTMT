includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"

params {
    mzML_csv = '/path/to/mzML.csv'
    channel_csv = '/path/to/channel.csv'
    plex_type = 'tmt10plex' // Shared by all plexes; required for mzML input.
    consensusXML_entrypoint = false // Set true and replace mzML_csv with consensusXML_csv for premerged input.
    idXML_csv = '/path/to/idXML.csv'
    output_dir = '/path/to/output'
    save_intermediate_files = false
    protein_quantifier_best_charge_and_fraction = true
    tmt_normalization_method = 'mad' // 'mad' or 'openms'; requires mzML input for 'openms'
    mad_normalizer_quasi_intensity = true
    resource_allocation_profile_tag = 'default'
}

methods.setup()
