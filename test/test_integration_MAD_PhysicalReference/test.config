includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

params {
    dataset_id = 'Ecoli_12prot_spike'
    mzML_csv = "${projectDir}/test/test_integration_MAD_PhysicalReference/mzML.csv"
    channel_csv = "${projectDir}/test/test_integration_MAD_PhysicalReference/channel.csv"
    plex_type = 'tmt10plex'
    idXML_csv = "${projectDir}/test/test_integration_MAD_PhysicalReference/idXML.csv"
    save_intermediate_files = true

    MADNormalizer {
        virtual_reference = false
    }
    enable_tmt_normalization = true
    tmt_normalization_method = 'mad'
    filter_na_consensus_handles = false
    ProteinQuantifier {
        best_charge = true
    }
}

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
params.mzML_csv = csvEnvironmentExpander.prepareInputCsv(params.mzML_csv, "test_integration_MAD_PhysicalReference-mzML_csv", launchDir)
params.idXML_csv = csvEnvironmentExpander.prepareInputCsv(params.idXML_csv, "test_integration_MAD_PhysicalReference-idXML_csv", launchDir)
methods.setup()

process {
    echo = false
    debug = false
}
