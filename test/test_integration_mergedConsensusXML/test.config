includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

params {
    output_dir = System.getenv('NFT_OUTPUT') ?: "${projectDir}/test/output"
    consensusXML_csv = "${projectDir}/test/test_integration_mergedConsensusXML/consensusXML.csv"
    consensusXML_entrypoint = true
    idXML_csv = "${projectDir}/test/test_integration_mergedConsensusXML/idXML.csv"
    save_intermediate_files = true

    remove_mapped_consensus = true

    enable_tmt_normalization = true
    tmt_normalization_method = 'mad'
}

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
params.consensusXML_csv = csvEnvironmentExpander.prepareInputCsv(params.consensusXML_csv, 'test_integration_mergedConsensusXML-consensusXML_csv', launchDir)
params.idXML_csv = csvEnvironmentExpander.prepareInputCsv(params.idXML_csv, 'test_integration_mergedConsensusXML-idXML_csv', launchDir)
methods.setup()

process {
    echo = false
}
