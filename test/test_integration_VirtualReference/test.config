includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def DATA_DIR = System.getenv('DATA_DIR') ?: "${projectDir}/test/fixtures"

params {
    input_csv = "${projectDir}/test/test_integration_VirtualReference/input.csv"
    idXML = "${DATA_DIR}/ecoli_tmt/validate-ProteomicPSM/Ecoli_12prot_spike_Fr1/validate-ProteomicPSM-1.0.0/Ecoli_12prot_spike_Fr1/OpenMS-3.5.0/output/Ecoli_12prot_spike_Fr1_MSFragger_filter.idXML"
    plex_name = 'Ecoli_12prot_spike_Fr1'
    save_intermediate_files = true

    isobaric_analyzer_type = 'tmt10plex'
    reference_channel = null
    virtual_reference = true
    virtual_reference_method = 'median'
    enable_tmt_normalization = true
    tmt_normalization_method = 'mad'
    filter_na_consensus_handles = false
    channel_description = "${projectDir}/test/test_integration_VirtualReference/channel.csv"

    protein_quantifier_best_charge_and_fraction = true
}

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
params.input_csv = csvEnvironmentExpander.prepareInputCsv(params.input_csv, 'test_integration_VirtualReference-input_csv', launchDir)
methods.setup()

process {
    echo = false
}
