includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

params {
    dataset_id = 'Ecoli_12prot_spike'
    mzML_csv = "${projectDir}/test/test_integration_FeatureBasedTMT/mzML.csv"
    idXML_csv = "${projectDir}/test/test_integration_FeatureBasedTMT/idXML.csv"
    channel_csv = "${projectDir}/test/test_integration_FeatureBasedTMT/channel.csv"
    plex_type = 'tmt10plex'
    tmt_workflow = 'feature_based'
    enable_tmt_normalization = true
    tmt_normalization_method = 'mad'
    MADNormalizer.quasi_intensity = true
    MADNormalizer.virtual_reference = true
    MADNormalizer.virtual_reference_method = 'median'
    MADNormalizer.virtual_reference_min_channels = 1
    MADNormalizer.bridge_scale = true
    MADNormalizer.allow_virtual_bridge = true
    save_intermediate_files = true
}

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
params.mzML_csv = csvEnvironmentExpander.prepareInputCsv(params.mzML_csv, 'test_integration_FeatureBasedTMT-mzML_csv', launchDir)
params.idXML_csv = csvEnvironmentExpander.prepareInputCsv(params.idXML_csv, 'test_integration_FeatureBasedTMT-idXML_csv', launchDir)
methods.setup()

process {
    echo = false
}
